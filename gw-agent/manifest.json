{
  "manifest_version": 3,
  "name": "GW Agent",
  "version": "1.17.5",
  "description": "매장 PC에서 GW·MIS·플젝 HR 일을 대신합니다: 폰 발주앱의 GW 전송을 MIS 주문등록에 넣고, 어제 매출·메뉴 판매·시간대별 매출·Set판매현황과 플젝 HR 출퇴근·스케줄 변경 신청을 스스로 읽어 옵니다. 당일 Gross·오늘 Set판매현황·오늘 메뉴별 판매는 매시간 한 번 더 읽고, 저녁 21:20에 그날 마지막 값을 한 덩어리로 남깁니다. MFG HR Board의 [HR 전송]을 받아 플젝 HR 주간스케쥴(시간)에 엑셀로 올리고 저장·공지·확정합니다. 필요할 때만 창 하나를 열어 로그인부터 끝까지 하고 닫습니다.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "webNavigation",
    "background",
    "sidePanel"
  ],
  "host_permissions": [
    "https://mis.madforgarlic.com/*",
    "https://gw.madforgarlic.com/*",
    "https://hr.pljec.cloud/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://hr-board-teal.vercel.app/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GW Agent"
  },
  "options_page": "popup.html",
  "content_scripts": [
    {
      "matches": [
        "https://gw.madforgarlic.com/*",
        "https://mis.madforgarlic.com/*"
      ],
      "js": [
        "login.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mis.madforgarlic.com/*"
      ],
      "js": [
        "start.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://hr.pljec.cloud/*"
      ],
      "js": [
        "hr.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://hr-board-teal.vercel.app/*"
      ],
      "js": [
        "hrsend-board.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
